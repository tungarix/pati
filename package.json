{
  "name": "pati",
  "version": "0.5.2",
  "description": "Masaüstünde yaşayan, konuşan, hatırlatan ve tamamen özelleştirilebilen maskot.",
  "main": "dist/main.js",
  "author": "Arda",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "eval": "node eval/run.ts",
    "dist": "npm run build && node scripts/fetch-piper.mjs && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "tungarix",
      "repo": "pati"
    },
    "appId": "com.arda.pati",
    "productName": "Pati",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "characters/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/piper",
        "to": "piper"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Pati"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
